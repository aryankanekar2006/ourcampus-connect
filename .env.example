
# Gemini AI API
GEMINI_API_KEY="your_gemini_api_key_here"

# Application URL
APP_URL="http://localhost:3000"

# PostgreSQL Connection Variables
SQL_HOST="localhost"
SQL_DB_NAME="OurCampus_Connect_DB"
SQL_USER="postgres"
SQL_PASSWORD="your_local_database_password"
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/OurCampus_Connect_DB"

# First Principal Account Setup
PRINCIPAL_REGISTRATION_KEY="your_principal_registration_key_here"
